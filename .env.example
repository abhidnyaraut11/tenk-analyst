# Copy this file to .env and fill in your own values.
# Never share .env, never paste a key into the Claude chat, and never commit .env to GitHub.

# OpenRouter: the LLM and the embeddings. Give this key a credit limit, such as two dollars.
OPENROUTER_API_KEY=

# Qdrant Cloud: the vector database. Both values are on your cluster's page.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tenk

# Neon: conversation memory. The direct connection string (its host does not contain "-pooler").
NEON_DATABASE_URL=

# LangSmith: tracing. Keep LANGSMITH_TRACING=true; the app traces itself when the key is set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tenk-analyst

# SEC asks every program that reads its data to give a name and an email address.
SEC_USER_AGENT=Your Name your.email@example.com

# The access code that people must type before they can use your app.
ACCESS_CODE=

# Where the front end finds the back end. On your laptop this is the default.
API_URL=http://localhost:8000

# The chat model on OpenRouter. Leave it as it is unless your instructor says otherwise.
CHAT_MODEL=anthropic/claude-haiku-5.5
